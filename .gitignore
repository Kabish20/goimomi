# =============================================================================
# Goimomi Workspace — Root .gitignore
# =============================================================================

# ---- OS Generated ----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# ---- IDE / Editor ----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ---- General ----
*.log
*.tmp
*.bak
tmp/

# ---- Archives (deployment artifacts) ----
*.tar.gz
*.zip
*.rar
*.7z

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
goimomibackend/db.sqlite3
goimomibackend/db.sqlite3-journal
goimomibackend/mig_out.txt

# ---- Node.js ----
node_modules/
goimomifrontend/dist/
goimomifrontend/dist-ssr/

# ---- Environment files (contain secrets) ----
.env
.env.local
.env.*.local
goimomibackend/.env
goimomifrontend/.env

# ---- Secrets / Credentials ----
self_client.json
*.pem
*.key

# ---- Media uploads (user-generated content) ----
goimomibackend/media/

# ---- Non-code assets ----
*.pdf

# ---- Agents / AI ----
.agents/
.rehost/
goimomi_known_hosts

# ---- Local verification output ----
output/
goimomibackend/hotel_destinations.json
goimomibackend/hotel_destinations.tmp
goimomifrontend/design/**/verification.json
goimomifrontend/design/**/desktop-*.png
goimomifrontend/design/**/mobile-*.png
goimomifrontend/design/**/*-desktop.png
goimomifrontend/design/**/*-mobile.png
test_screenshots/
.release_tmp/
