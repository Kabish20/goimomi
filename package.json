{
  "name": "goimomi-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Goimomi Full-Stack Workspace",
  "scripts": {
    "dev": "scripts\\start_dev.bat",
    "dev:backend": "cd goimomibackend && python manage.py runserver 0.0.0.0:8000",
    "dev:frontend": "cd goimomifrontend && npm run dev",
    "build:frontend": "cd goimomifrontend && npm run build",
    "check:backend": "cd goimomibackend && python manage.py check",
    "test:backend": "cd goimomibackend && python manage.py test --settings=backend.test_settings",
    "test:frontend": "cd goimomifrontend && npm test",
    "test:packaging": "python -m unittest discover -s scripts -p test_*.py",
    "lint:frontend": "cd goimomifrontend && npm run lint",
    "seed:logistics": "cd goimomibackend && python manage.py seed_logistics",
    "seed:visas": "cd goimomibackend && python manage.py seed_popular_visas",
    "zip:package": "python scripts/create_zip.py"
  }
}
