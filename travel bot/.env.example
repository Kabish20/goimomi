# Application Settings
PROJECT_NAME="AI Travel Assistant"
VERSION="1.0.0"
DEBUG=true
API_V1_PREFIX="/api"

# Database Configuration (PostgreSQL + asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/travelbot"
# Set to true to automatically fallback to local SQLite (sqlite+aiosqlite:///./travelbot.db) if Postgres is unavailable
USE_SQLITE_FALLBACK=true

# Redis Cache & Background Tasks
REDIS_URL="redis://localhost:6379/0"

# AI / LLM Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_VERIFY_TOKEN="travelbot_secure_verify_token_2026"
WHATSAPP_API_VERSION="v20.0"
# In mock mode, outgoing messages are logged cleanly to console/db instead of failing HTTP calls
WHATSAPP_MOCK_MODE=true

# Zoho Payments Gateway
ZOHO_CLIENT_ID="your-zoho-client-id"
ZOHO_CLIENT_SECRET="your-zoho-client-secret"
ZOHO_MERCHANT_ID="your-merchant-id"
ZOHO_PAYMENT_URL="https://payments.zoho.com/api/v1/paymentlinks"
ZOHO_MOCK_MODE=true

# Live B2B Flight API
FLIGHT_API_KEY="2136600e825085-3cb6-4361-b5cf-910217fd6152"
FLIGHT_API_BASE_URL="https://tripjack.com"
FLIGHT_API_TEST_BASE_URL="https://apitest.tripjack.com"
FLIGHT_API_USE_TEST_ENV=false
FLIGHT_API_MOCK_MODE=false
